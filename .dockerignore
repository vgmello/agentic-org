# The image is built from prebuilt executables (deploy/container/Dockerfile): the build
# context is the repository root, and only these files are sent to the Docker daemon.
*
!deploy/container/setup.json
!target/debug/agentic-org
!target/debug/agentic-org-office
!target/debug/agentic-org-web
!target/debug/agent-os
!target/release/agentic-org
!target/release/agentic-org-office
!target/release/agentic-org-web
!target/release/agent-os
