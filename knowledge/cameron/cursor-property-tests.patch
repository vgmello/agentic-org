+    let mut out: Vec<String> = Vec::new();
+    let mut run = |name: String, q: WorkActivityQuery| {
+        let r = fx.reads.activity_page(&q);
+        out.push(format!("QAWORK {name} -> {}", wk_kind(&r)));
+    };
+    for limit in [0u32, 1, u32::MAX] {
+        for scan in [0u32, 1, 2, u32::MAX] {
+            let mut q = query(head);
+            (q.limit, q.scan) = (limit, scan);
+            run(format!("limit {limit} scan {scan}"), q);
+        }
+    }
+    let befores = [
+        ("before = newest event", pos(4, "C", 2)),
+        ("before = oldest event", pos(1, "A", 1)),
+        ("before = marker of ceiling row", marker(4)),
+        ("before = marker of empty row 2", marker(2)),
+        ("before = marker of row 1", marker(1)),
+        ("before = marker row 0", marker(0)),
+        ("before = marker row head+1", marker(5)),
+        ("before = marker version 1", pos(2, "", 1)),
+        ("before = missing target", pos(4, "Z", 1)),
+        ("before = target not in row", pos(2, "A", 1)),
+        ("before = version not committed", pos(4, "A", 9)),
+        ("before = version 0 on a target", pos(4, "A", 0)),
+        ("before = feed_seq u64::MAX marker", marker(u64::MAX)),
+        ("before = feed_seq i64::MAX marker", marker(i64::MAX as u64)),
+        ("before = feed_seq i64::MAX+1 marker", marker(i64::MAX as u64 + 1)),
+        ("before = feed_seq i64::MAX+1 target", pos(i64::MAX as u64 + 1, "A", 1)),
+        ("before = version i64::MAX+1", pos(1, "A", i64::MAX as u64 + 1)),
+    ];
+    for (name, b) in befores {
+        let mut q = query(head);
+        q.before = Some(b.clone());
+        run(name.into(), q);
+        let mut q = query(u64::MAX);
+        q.before = Some(b);
+        run(format!("{name} (ceiling u64::MAX)"), q);
+    }
+    for (name, ceiling) in [
+        ("ceiling 0", 0u64),
+        ("ceiling head+1", head + 1),
+        ("ceiling 1<<62", 1 << 62),
+        ("ceiling i64::MAX", i64::MAX as u64),
+        ("ceiling i64::MAX+1", i64::MAX as u64 + 1),
+        ("ceiling u64::MAX", u64::MAX),
+    ] {
+        run(name.into(), query(ceiling));
+        let mut q = query(ceiling);
+        q.incarnation = None;
