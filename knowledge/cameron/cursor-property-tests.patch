+    for (name, pk) in [("prev_key 0", 0u64), ("prev_key MAX", u64::MAX)] {
+        let mut q = query(head);
+        q.prev_key = pk;
+        run(name.into(), q);
+    }
+    for (limit, scan) in [(1u32, 1u32), (0, 0)] {
+        let mut q = query(head);
+        (q.limit, q.scan, q.team_members) = (limit, scan, Some(vec![]));
+        run(format!("team_members empty, limit {limit} scan {scan}"), q);
+        let mut q = query(head);
+        (q.limit, q.scan, q.team_members) = (limit, scan, Some(vec!["m2".into()]));
+        run(format!("team_members [m2], limit {limit} scan {scan}"), q);
+        let mut q = query(head);
+        (q.limit, q.scan, q.member) = (limit, scan, Some("m1".into()));
+        run(format!("member m1, limit {limit} scan {scan}"), q);
+        let mut q = query(head);
+        (q.limit, q.scan, q.project) = (limit, scan, Some("nowhere".into()));
+        run(format!("project none, limit {limit} scan {scan}"), q);
+    }
+    let mut q = query(head);
+    q.incarnation = Some(org_work::ulid_from_parts(T0, 9));
+    run("wrong incarnation".into(), q);
+    for line in &out {
+        eprintln!("{line}");
+    }
+    // empty log
+    let empty = setup(true);
+    let show = |name: &str, q: WorkActivityQuery| eprintln!("QAWORK empty log {name} -> {}", wk_kind(&empty.reads.activity_page(&q)));
+    show("ceiling 0", query(0));
+    show("ceiling 5", query(5));
+    let mut q = query(0);
+    q.before = Some(marker(0));
+    show("before marker 0", q);
+    // one-row log
+    let one = setup(true);
+    one.commit(vec![vec![ev("A", T0)]]);
+    let show = |name: &str, q: WorkActivityQuery| eprintln!("QAWORK one-row log {name} -> {}", wk_kind(&one.reads.activity_page(&q)));
+    show("ceiling 1", query(1));
+    let mut q = query(1);
+    q.before = Some(pos(1, "A", 1));
+    show("before A1", q.clone());
+    q.before = Some(marker(1));
+    show("before marker 1", q);
+    // lastly a no-incarnation office with events
+    let bare = setup(false);
+    bare.commit(vec![vec![ev("A", T0)]]);
+    let mut q = query(1);
+    q.incarnation = None;
+    eprintln!("QAWORK no-incarnation office, incarnation None ceiling 1 -> {}", wk_kind(&bare.reads.activity_page(&q)));
+}
