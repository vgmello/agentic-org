+#[test]
+fn qa_random_walks_join_to_the_unpaged_read_and_match_the_oracle() {
+    let mut walks = 0;
+    let mut single = 0;
+    for seed in 1..=40u64 {
+        let size = QA_SIZES[(seed % 7) as usize] as usize;
+        let (_dir, store, mut rng) = qa_build(seed, size, size <= 40);
+        let head = head_seq(&store);
+        let rows = qa_oracle_rows(&store, 1);
+        // Unfiltered whole read.
+        let mut base = query(head);
+        (base.limit, base.scan) = (usize::MAX, usize::MAX);
+        let whole = read(&store, &base).unwrap();
+        assert!(whole.exhausted);
+        // keys vs a model: running min of parseable `at` newest first, per row
+        let mut key = u64::MAX;
+        let mut expect_keys = Vec::new();
+        for r in &rows {
+            key = time::parse_rfc3339_ms(&r.at).map_or(key, |a| a.min(key));
+            expect_keys.extend(std::iter::repeat(key).take(r.changes.len()));
+        }
+        assert_eq!(
+            whole.entries.iter().map(|e| e.key).collect::<Vec<_>>(),
+            expect_keys
+        );
+        // Random walks, random filters.
+        let big = size > 300;
+        for _ in 0..4 {
+            let mut q = query(if rng.chance(30) && head > 1 { 1 + rng.below(head) } else { head });
+            q.limit = rng.pick(&QA_LS);
+            q.scan = rng.pick(&QA_LS);
+            if big && (q.limit <= 3 || q.scan <= 1) && rng.chance(70) {
+                q.limit = 100;
+            }
+            qa_random_filters(&mut rng, &mut q);
+            if rng.chance(20) {
+                q.prev_key = rng.pick(&[0u64, T0 + 20_000, u64::MAX - 1]);
+            }
+            let mut whole_q = q.clone();
+            (whole_q.limit, whole_q.scan) = (usize::MAX, usize::MAX);
+            let whole_f = read(&store, &whole_q).unwrap();
+            assert!(whole_f.exhausted);
+            // filter equals the unfiltered read filtered afterwards (keys are filter-independent)
+            let mut unf = whole_q.clone();
+            (unf.member, unf.team, unf.project) = (None, None, None);
+            let unf = read(&store, &unf).unwrap();
+            let expected: Vec<_> = unf
+                .entries
+                .iter()
+                .filter(|e| q.matches(e.actor.as_deref(), &e.subject))
+                .cloned()
+                .collect();
+            assert_eq!(whole_f.entries, expected, "filter after vs before: {whole_q:?}");
+            let (joined, pages) = qa_walk(&store, &rows, q.clone());
+            assert_eq!(joined, whole_f.entries, "join != unpaged: {q:?} ({pages} pages)");
+            walks += 1;
+        }
+        // Random single pages from random cursors.
+        for _ in 0..25 {
+            let mut q = query(head);
+            if rng.chance(50) {
+                q.ceiling = rng.below(head + 1);
+            }
+            q.limit = rng.pick(&QA_LS);
+            q.scan = rng.pick(&QA_LS);
+            qa_random_filters(&mut rng, &mut q);
+            q.prev_key = rng.pick(&[u64::MAX, 0, T0 + 30_000, T0, 1]);
+            if q.ceiling >= 1 && rng.chance(70) {
+                let seq = 1 + rng.below(q.ceiling);
+                let len = rows.iter().find(|r| r.seq == seq).map_or(0, |r| r.changes.len());
+                let small = rng.below(4) as usize;
+                let index = rng.pick(&[0usize, 1, len, len + 1, usize::MAX, small]);
+                q.before = Some(position(seq, index));
+            }
+            let got = read(&store, &q).unwrap();
+            let (e, s, f, x) = qa_oracle_page(&rows, &q);
+            assert_eq!((got.entries, got.scanned_to, got.frontier, got.exhausted), (e, s, f, x), "{q:?}");
+            single += 1;
+        }
+    }
+    eprintln!("QA org: {walks} walks, {single} single pages");
+}
