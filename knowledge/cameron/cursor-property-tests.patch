+#[test]
+fn qa_org_edge_table() {
+    let (_dir, store) = store();
+    append(
+        &store,
+        vec![
+            (at(T0 + 10), vec![team("T1", 1), member("M1", 1)]),
+            (at(T0 + 20), vec![project("P1", 1, false)]),
+            (at(T0 + 30), vec![project("P1", 2, true), team("T1", 2), team("T1", 3)]),
+            (at(T0 + 25), vec![removed("membership", "GHOST")]),
+            (at(T0 + 40), vec![member("M2", 1), member("M2", 2), member("M2", 3)]),
+        ],
+    );
+    let head = head_seq(&store);
+    assert_eq!(head, 6);
+    let mut table: Vec<(String, String)> = Vec::new();
+    let mut run = |name: String, q: OrgActivityQuery| {
+        let r = read(&store, &q);
+        table.push((name, qa_kind(&r)));
+    };
+    for limit in [0usize, 1, usize::MAX] {
+        for scan in [0usize, 1, 2, usize::MAX] {
+            let mut q = query(head);
+            (q.limit, q.scan) = (limit, scan);
+            run(format!("limit {limit} scan {scan}"), q);
+        }
+    }
+    for (name, seq, index) in [
+        ("before=ceiling row idx0", 6u64, 0usize),
+        ("before=ceiling row idx1", 6, 1),
+        ("before=ceiling row idx=len", 6, 3),
+        ("before=ceiling row idx=MAX", 6, usize::MAX),
+        ("before above ceiling", 7, 0),
+        ("before first row idx0", 1, 0),
+        ("before first row idx1", 1, 1),
+        ("before seq 0", 0, 0),
+        ("before seq u64::MAX", u64::MAX, 0),
+        ("before seq i64::MAX", i64::MAX as u64, 0),
+        ("before seq i64::MAX+1", i64::MAX as u64 + 1, 0),
+    ] {
+        let mut q = query(head);
+        q.before = Some(position(seq, index));
+        run(name.into(), q);
+    }
+    for (name, ceiling) in [
+        ("ceiling 0", 0u64),
+        ("ceiling head+1", head + 1),
+        ("ceiling 1<<62", 1 << 62),
+        ("ceiling i64::MAX", i64::MAX as u64),
+        ("ceiling i64::MAX+1", i64::MAX as u64 + 1),
+        ("ceiling u64::MAX", u64::MAX),
+    ] {
+        run(name.into(), query(ceiling));
+        let mut q = query(ceiling);
+        q.before = Some(position(3, 0));
+        run(format!("{name} + before 3/0"), q);
+    }
+    for (name, pk) in [("prev_key 0", 0u64), ("prev_key MAX", u64::MAX)] {
+        let mut q = query(head);
+        q.prev_key = pk;
+        run(name.into(), q);
+    }
+    for epoch in [0u64, 2, u64::MAX, i64::MAX as u64 + 1] {
+        let mut q = query(head);
+        q.epoch = epoch;
+        run(format!("epoch {epoch}"), q);
+        let mut q = query(head);
+        q.before = Some(ActivityPosition { epoch, seq: 3, index: 0 });
+        run(format!("before.epoch {epoch}"), q);
+    }
+    // ceiling 0 with the log
+    let mut q = query(0);
+    q.limit = 0;
+    run("ceiling 0 limit 0".into(), q);
+    for (name, t) in table {
+        eprintln!("QAORG {name} -> {t}");
+    }
+    // a seq with no org.changed row (other kind), retained range
+    store.run_sql_for_test(
+        "INSERT INTO events (epoch, seq, kind, command_id, at, body)
+         VALUES (1, 7, 'x.y', 'X7', 'zzz', 'nope')",
+    );
+    let mut q = query(7);
+    q.before = Some(position(7, 0));
+    eprintln!("QAORG before at other-kind row 7/0 -> {}", qa_kind(&read(&store, &q)));
+    q.before = Some(position(7, 5));
+    eprintln!("QAORG before at other-kind row 7/5 -> {}", qa_kind(&read(&store, &q)));
+    // one row log
+    let (_d2, s2) = store_one();
+    eprintln!("QAORG one-row log -> {}", qa_kind(&read(&s2, &query(1))));
+    let mut q = query(1);
+    q.before = Some(position(1, 0));
+    eprintln!("QAORG one-row before 1/0 -> {}", qa_kind(&read(&s2, &q)));
+    q.before = Some(position(1, 1));
+    eprintln!("QAORG one-row before 1/1 -> {}", qa_kind(&read(&s2, &q)));
+    // empty log
+    s2.run_sql_for_test("DELETE FROM events");
+    eprintln!("QAORG empty log ceiling 0 -> {}", qa_kind(&read(&s2, &query(0))));
+    eprintln!("QAORG empty log ceiling 1 -> {}", qa_kind(&read(&s2, &query(1))));
+}
