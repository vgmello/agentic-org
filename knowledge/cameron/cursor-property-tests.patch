+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x << 13;
+        x ^= x >> 7;
+        x ^= x << 17;
+        self.0 = x;
+        x
+    }
+    fn below(&mut self, n: u64) -> u64 {
+        self.next() % n
+    }
+    fn pick<T: Copy>(&mut self, xs: &[T]) -> T {
+        xs[self.below(xs.len() as u64) as usize]
+    }
+    fn chance(&mut self, pct: u64) -> bool {
+        self.below(100) < pct
+    }
+}
+
+fn qa_change(rng: &mut Rng, ghosts: bool) -> OrgChange {
+    let n = rng.below(6);
+    let id = |p: &str| format!("{p}{n}");
+    let version = rng.pick(&[1u64, 1, 2, 3, 0]);
+    match rng.below(11) {
+        0 => team(&id("T"), version),
+        1 => member(&id("M"), version),
+        2 => membership(&id("S"), &id("T"), &id("M"), version),
+        3 => project_team(&id("Q"), &id("P"), &id("T"), version),
+        4 | 5 => project(&id("P"), version, rng.chance(40)),
+        6 => area(&id("A"), &id("P"), version, rng.chance(30)),
+        7 => match rng.below(4) {
+            0 => removed("team", &id("T")),
+            1 => removed("member", &id("M")),
+            2 => removed("membership", &id("S")),
+            _ => removed("project_team", &id("Q")),
+        },
+        8 if ghosts => removed("membership", "GHOST"),
+        8 => member(&id("M"), version),
+        9 => change(json!({"type": "a_kind_from_the_future"})),
+        _ => project(&id("P"), version, rng.chance(40)),
+    }
+}
+
+fn qa_rows(rng: &mut Rng, n: usize, ghosts: bool) -> Rows {
+    let mut clock = T0 + 10_000;
+    (0..n)
+        .map(|_| {
+            clock = match rng.below(10) {
+                0 => clock.saturating_sub(rng.below(60_000)).max(T0),
+                1 => clock,
+                _ => clock + rng.below(5_000),
+            };
+            let stamp = match rng.below(25) {
+                0 => "garbage".to_string(),
+                1 => "2026-11-08T12:00:00+01:00".to_string(),
+                2 => "1969-12-31T23:59:59.999Z".to_string(),
+                _ => at(clock),
+            };
+            let count = rng.pick(&[0usize, 1, 1, 1, 2, 3, 5]);
+            let changes = (0..count).map(|_| qa_change(rng, ghosts)).collect();
+            (stamp, changes)
+        })
+        .collect()
+}
+
+struct OrgRow {
+    seq: u64,
+    command_id: String,
+    at: String,
+    actor: Option<String>,
+    changes: Vec<OrgChange>,
+}
+
+/// Newest first, read straight from the table (independent of `Log`).
+fn qa_oracle_rows(store: &Store, epoch: u64) -> Vec<OrgRow> {
+    store
+        .read(|db| {
+            let mut s = db
+                .prepare(
+                    "SELECT e.seq, e.command_id, e.at, e.body, c.principal_member FROM events e
+                     LEFT JOIN commands c USING (command_id) WHERE e.kind = 'org.changed'
+                     AND e.epoch = ?1 ORDER BY e.seq DESC",
+                )
+                .unwrap();
+            let rows = s
+                .query_map([epoch as i64], |r| {
+                    Ok(OrgRow {
+                        seq: r.get::<_, i64>(0)? as u64,
+                        command_id: r.get(1)?,
+                        at: r.get(2)?,
+                        changes: serde_json::from_str(&r.get::<_, String>(3)?).unwrap(),
+                        actor: r.get(4)?,
+                    })
+                })
+                .unwrap()
+                .collect::<rusqlite::Result<Vec<_>>>()
+                .unwrap();
+            Ok(rows)
+        })
+        .unwrap()
+}
+
+fn qa_describe(rows: &[OrgRow], k: usize, i: usize) -> (String, rules::ActivitySubject) {
+    let change = &rows[k].changes[i];
+    let mut previous = None;
+    if let Some(((kind, id), _)) = rules::entity(change).filter(|_| rules::needs_previous(change)) {
+        'find: for j in k..rows.len().min(k + LOOKBACK_ROWS + 1) {
+            let upto = if j == k { i } else { rows[j].changes.len() };
+            for x in (0..upto).rev() {
+                if let Some(((k2, id2), true)) = rules::entity(&rows[j].changes[x]) {
+                    if k2 == kind && id2 == id {
+                        previous = Some(&rows[j].changes[x]);
+                        break 'find;
+                    }
+                }
+            }
+        }
+    }
+    rules::describe(change, previous)
+}
+
+/// The documented semantics, over memory: (entries, scanned_to, frontier, exhausted).
+fn qa_oracle_page(
+    all_rows: &[OrgRow],
+    q: &OrgActivityQuery,
+) -> (Vec<ActivityEntry>, Option<ActivityPosition>, u64, bool) {
+    let mut top = q.ceiling;
+    if let Some(b) = q.before {
+        top = top.min(b.seq - u64::from(b.index == 0));
+    }
+    let start = all_rows.iter().position(|r| r.seq <= top).unwrap_or(all_rows.len());
+    let rows = &all_rows[start..];
+    let (mut entries, mut scanned_to, mut frontier) = (Vec::new(), None, q.prev_key);
+    let (limit, scan) = (q.limit.max(1), q.scan.max(1));
+    for (k, row) in rows.iter().enumerate() {
+        if k == scan {
+            return (entries, scanned_to, frontier, false);
+        }
+        let at_ms = time::parse_rfc3339_ms(&row.at);
+        let key = at_ms.map_or(frontier, |a| a.min(frontier));
+        let below = q
+            .before
+            .filter(|b| b.seq == row.seq)
+            .map_or(usize::MAX, |b| b.index);
+        for index in (0..row.changes.len().min(below)).rev() {
+            let (verb, subject) = qa_describe(rows, k, index);
+            if !q.matches(row.actor.as_deref(), &subject) {
+                continue;
+            }
+            if entries.len() == limit {
+                let last: &ActivityEntry = entries.last().unwrap();
+                return (entries.clone(), Some(last.position), last.key, false);
+            }
+            entries.push(ActivityEntry {
+                position: position(row.seq, index),
+                verb,
+                at_ms,
+                key,
+                actor: row.actor.clone(),
+                subject,
+                group: row.command_id.clone(),
+            });
+        }
+        scanned_to = Some(position(row.seq, 0));
+        frontier = key;
+    }
+    (entries, scanned_to, frontier, true)
+}
+
+fn qa_random_filters(rng: &mut Rng, q: &mut OrgActivityQuery) {
+    if rng.chance(30) {
+        q.member = Some(rng.pick(&["M0", "M1", "M3", "MA0", "MA1", "MX"]).into());
+    }
+    if rng.chance(30) {
+        let members: Vec<String> = match rng.below(3) {
+            0 => vec![],
+            1 => vec!["M2".into()],
+            _ => vec!["M1".into(), "MA1".into(), "MA3".into()],
+        };
+        q.team = Some(TeamFilter {
+            id: rng.pick(&["T0", "T2", "T5", "TX"]).into(),
+            members,
+        });
+    }
+    if rng.chance(30) {
+        q.project = Some(rng.pick(&["P0", "P1", "P4", "PX"]).into());
+    }
+}
+
+const QA_SIZES: [u64; 7] = [0, 1, 2, 5, 40, 300, 1500];
+const QA_LS: [usize; 7] = [0, 1, 2, 3, 7, 100, 2000];
+
+fn qa_build(seed: u64, size: usize, ghosts: bool) -> (TempDir, Store, Rng) {
+    let mut rng = Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1);
+    let (dir, store) = store();
+    append(&store, qa_rows(&mut rng, size, ghosts));
+    store.run_sql_for_test(
+        "INSERT INTO commands (command_id, epoch, seq, expires_at, principal_member)
+         SELECT command_id, epoch, seq, '2026-12-08T12:00:00.000Z', 'MA' || (seq % 4)
+         FROM events WHERE seq > 1 AND seq % 3 <> 0",
+    );
+    (dir, store, rng)
+}
