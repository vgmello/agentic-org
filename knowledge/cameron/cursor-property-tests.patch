+            (w.limit, w.scan) = (usize::MAX, usize::MAX);
+            let whole = read(&store, &w).unwrap();
+            let (joined, _) = qa_walk(&store, &rows, q.clone());
+            assert_eq!(joined, whole.entries, "{q:?}");
+            walks += 1;
+        }
+        for _ in 0..30 {
+            let mut q = query(head);
+            if rng.chance(30) {
+                q.ceiling = 1 + rng.below(head);
+            }
+            (q.limit, q.scan) = (rng.pick(&[1usize, 50, 2_000]), rng.pick(&[1usize, 100, 2_000, usize::MAX]));
+            qa_random_filters(&mut rng, &mut q);
+            let seq = 1 + rng.below(q.ceiling);
+            q.before = Some(position(seq, rng.below(3) as usize));
+            let got = read(&store, &q).unwrap();
+            let (e, s, f, x) = qa_oracle_page(&rows, &q);
+            assert_eq!((got.entries, got.scanned_to, got.frontier, got.exhausted), (e, s, f, x), "{q:?}");
+            single += 1;
+        }
+    }
+    eprintln!("QA org large: {walks} walks, {single} single pages");
+}
