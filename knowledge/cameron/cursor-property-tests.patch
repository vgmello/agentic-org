+#[test]
+fn qa_org_epoch_change_between_pages_needs_a_snapshot_and_returns_no_rows() {
+    let (_dir, store) = store();
+    append(&store, filler(6));
+    let mut q = query(7);
+    q.limit = 2;
+    let first = read(&store, &q).unwrap();
+    (q.before, q.prev_key) = (first.scanned_to, first.frontier);
+    // rows 5..7 move to a new epoch 2 (as a replaced history would)
+    store.run_sql_for_test("UPDATE events SET epoch = 2 WHERE seq >= 5");
+    let r = read(&store, &q);
+    eprintln!("QAORG epoch moved: {}", qa_kind(&r));
+    assert!(matches!(r, Err(ActivityError::SnapshotRequired)));
+    // epoch-2 query with epoch-1 cursor
+    let mut q2 = query(7);
+    q2.epoch = 2;
+    q2.before = first.scanned_to;
+    assert!(matches!(read(&store, &q2), Err(ActivityError::SnapshotRequired)));
+    // epoch-2 page 1 only sees epoch-2 rows
+    q2.before = None;
+    let p = read(&store, &q2).unwrap();
+    assert!(p.entries.iter().all(|e| e.position.epoch == 2 && e.position.seq >= 5));
+    assert_eq!(p.entries.len(), 3);
+    assert!(p.exhausted && p.history_truncated);
+}
