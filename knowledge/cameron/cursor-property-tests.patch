+#[test]
+fn qa_work_page_with_a_ceiling_beyond_the_head_is_not_a_pure_function_of_its_query() {
+    let fx = setup(true);
+    fx.commit(vec![vec![ev("A", T0)], vec![ev("A", T0 + 1)]]);
+    let q = query(10);
+    let first = fx.reads.activity_page(&q).unwrap();
+    fx.commit(vec![vec![ev("B", T0 + 2)]]);
+    let second = fx.reads.activity_page(&q).unwrap();
+    assert_eq!(first, second, "same query, different page after a commit above the old head");
+}
