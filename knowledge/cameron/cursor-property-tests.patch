+#[test]
+fn qa_work_large_logs_cross_the_default_scan_cap() {
+    let (mut walks, mut single) = (0, 0);
+    for (seed, size) in [(201u64, 2_600usize), (202, 3_100)] {
+        let mut rng = Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1);
+        let fx = setup(true);
+        qa_fill(&fx, &mut rng, size);
+        let m = qa_model(&fx);
+        let head = fx.reads.head().unwrap().1;
+        for (limit, scan) in [(100u32, 2_000u32), (u32::MAX, u32::MAX), (3_000, 7), (50, 513), (1, 2_000)] {
+            let mut q = query(head);
+            (q.limit, q.scan) = (limit, scan);
+            qa_filters(&mut rng, &mut q);
+            if limit == 1 {
+                q.member = Some("m0".into());
+                q.limit = 40; // keep the walk short
+            }
+            let mut w = q.clone();
+            (w.limit, w.scan) = (u32::MAX, u32::MAX);
+            let whole = fx.reads.activity_page(&w).unwrap();
+            let (joined, _) = qa_walk(&fx, &m, q.clone());
+            assert_eq!(
+                joined,
+                whole.entries.iter().map(|e| (e.position.clone(), e.key)).collect::<Vec<_>>(),
+                "{q:?}"
+            );
+            walks += 1;
+        }
+        for _ in 0..30 {
+            let mut q = query(head);
+            if rng.chance(30) {
+                q.ceiling = 1 + rng.below(head);
+            }
+            (q.limit, q.scan) = (rng.pick(&[1u32, 50, 2_000]), rng.pick(&[1u32, 100, 2_000, u32::MAX]));
+            qa_filters(&mut rng, &mut q);
+            q.before = Some(m.events[rng.below(m.events.len() as u64) as usize].0.clone());
+            if q.before.as_ref().unwrap().feed_seq > q.ceiling {
+                q.before = Some(marker(q.ceiling));
+            }
+            let got = fx.reads.activity_page(&q).unwrap();
+            assert_eq!(qa_flat(&got), qa_oracle(&m, &q), "{q:?}");
+            single += 1;
+        }
+    }
+    eprintln!("QA work large: {walks} walks, {single} single pages");
+}
