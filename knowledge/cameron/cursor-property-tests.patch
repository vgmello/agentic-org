+#[test]
+fn qa_work_reads_do_not_write_under_random_pages() {
+    let fx = setup(true);
+    let mut rng = Rng(99);
+    qa_fill(&fx, &mut rng, 200);
+    let before = fx.meta_and_sequences();
+    let head = fx.reads.head().unwrap().1;
+    let spy = |db: &Connection| db.query_row("PRAGMA data_version", [], |r| r.get::<_, i64>(0)).unwrap();
+    fx.store
+        .read(|s| {
+            let v = spy(s);
+            for scan in [1u32, 100, u32::MAX] {
+                let mut q = query(head);
+                (q.scan, q.project) = (scan, Some("p1".into()));
+                fx.reads.activity_page(&q).unwrap();
+            }
+            fx.reads.latest_by_project(head, &["p1".into()]).unwrap();
+            assert_eq!(spy(s), v);
+            Ok(())
+        })
+        .unwrap();
+    assert_eq!(fx.meta_and_sequences(), before);
+}
