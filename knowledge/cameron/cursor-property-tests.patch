+#[test]
+fn qa_work_time_parser_never_panics_on_arbitrary_text() {
+    let mut rng = Rng(0xDEADBEEF);
+    let alphabet: Vec<&str> = vec!["0", "1", "2", "9", "-", "T", ":", ".", "Z", "+", " ", "\u{e9}", "\u{1F600}"];
+    for _ in 0..200_000 {
+        let n = rng.below(30);
+        let s: String = (0..n).map(|_| rng.pick(&alphabet)).collect();
+        let _ = org_work::parse_ms(&s);
+        let canon = format!(
+            "{:04}-{:02}-{:02}T{:02}:{:02}:{:02}.{:03}Z",
+            rng.below(10_000), rng.below(14), rng.below(33), rng.below(26), rng.below(62), rng.below(62), rng.below(1000)
+        );
+        let _ = org_work::parse_ms(&canon);
+        // multibyte text of exactly 24 bytes
+        let _ = org_work::parse_ms("2026-11-08T12:00:00.\u{e9}\u{e9}Z");
+    }
+}
