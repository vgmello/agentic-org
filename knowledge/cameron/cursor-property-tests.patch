+/// One checked walk: returns the joined entries and the number of pages.
+fn qa_walk(store: &Store, rows: &[OrgRow], start: OrgActivityQuery) -> (Vec<ActivityEntry>, usize) {
+    let (mut q, mut out, mut pages) = (start, Vec::new(), 0usize);
+    loop {
+        pages += 1;
+        assert!(pages <= 200_000, "no progress");
+        let page = read(store, &q).unwrap();
+        assert_eq!(page, read(store, &q).unwrap(), "pure function of the query");
+        assert!(page.entries.len() <= q.limit.max(1));
+        let (o_entries, o_scanned, o_frontier, o_exhausted) = qa_oracle_page(rows, &q);
+        assert_eq!(
+            (&page.entries, page.scanned_to, page.frontier, page.exhausted),
+            (&o_entries, o_scanned, o_frontier, o_exhausted),
+            "oracle mismatch for {q:?}"
+        );
+        // rows scanned never exceed scan
+        if let Some(to) = page.scanned_to {
+            let mut top = q.ceiling;
+            if let Some(b) = q.before {
+                top = top.min(b.seq - u64::from(b.index == 0));
+            }
+            let scanned = rows.iter().filter(|r| r.seq >= to.seq && r.seq <= top).count();
+            assert!(scanned <= q.scan.max(1), "scan cap {scanned} > {}", q.scan);
+        }
+        assert!(page.frontier <= q.prev_key);
+        for w in page.entries.windows(2) {
+            assert!(w[0].position > w[1].position && w[0].key >= w[1].key);
+        }
+        if let (Some(last_out), Some(first)) = (out.last(), page.entries.first()) {
+            let last_out: &ActivityEntry = last_out;
+            assert!(last_out.position > first.position, "duplicate/disorder at join");
+            assert!(last_out.key >= first.key);
+        }
+        out.extend(page.entries.iter().cloned());
+        if page.exhausted {
+            return (out, pages);
+        }
+        let to = page.scanned_to.expect("a non-exhausted page scanned something");
+        assert!(q.before.is_none_or(|b| to < b), "no progress: {to:?} vs {:?}", q.before);
+        (q.before, q.prev_key) = (Some(to), page.frontier);
+    }
+}
