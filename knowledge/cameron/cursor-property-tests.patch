+// ---- QA adversarial / property scratch tests (uncommitted) -----------------------------------
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        let mut x = self.0;
+        x ^= x << 13;
+        x ^= x >> 7;
+        x ^= x << 17;
+        self.0 = x;
+        x
+    }
+    fn below(&mut self, n: u64) -> u64 {
+        self.next() % n
+    }
+    fn pick<T: Copy>(&mut self, xs: &[T]) -> T {
+        xs[self.below(xs.len() as u64) as usize]
+    }
+    fn chance(&mut self, pct: u64) -> bool {
+        self.below(100) < pct
+    }
+}
+
+const QA_TARGETS: [&str; 9] = ["A", "B", "C", "H", "H", "H", "a", "Z9", "I001"];
+const QA_MEMBERS: [&str; 4] = ["m0", "m1", "m2", "m3"];
+
+fn qa_ev(rng: &mut Rng, clock: &mut u64) -> Ev {
+    *clock = match rng.below(10) {
+        0 => clock.saturating_sub(rng.below(60_000)).max(T0),
+        1 => *clock,
+        _ => *clock + rng.below(5_000),
+    };
+    let mut e = ev(rng.pick(&QA_TARGETS), *clock);
+    match rng.below(25) {
+        0 => e.at = "yesterday".into(),
+        1 => e.at = "1969-12-31T23:59:59.999Z".into(),
+        _ => {}
+    }
+    if rng.chance(70) {
+        e = e.by(rng.pick(&QA_MEMBERS));
+    } else {
+        e.actor = None;
+    }
+    if rng.chance(30) {
+        e = e.assigned(rng.pick(&QA_MEMBERS));
+    }
+    e
+}
+
+fn qa_fill(fx: &Fx, rng: &mut Rng, n: usize) {
+    let mut clock = T0 + 10_000;
+    let rows: Vec<Vec<Ev>> = (0..n)
+        .map(|_| {
+            let count = rng.pick(&[0usize, 1, 1, 2, 3, 5]);
+            (0..count).map(|_| qa_ev(rng, &mut clock)).collect()
+        })
+        .collect();
+    fx.commit(rows);
+    for t in QA_TARGETS {
+        if rng.chance(75) {
+            fx.place(t, rng.pick(&["p0", "p1", "p2"]));
+        }
+    }
+    if rng.chance(50) {
+        fx.store
+            .write(|db| {
+                db.execute(
+                    "UPDATE work_items SET data = json_set(data, '$.deleted', json('true')) WHERE id = 'B'",
+                    [],
+                )
+                .map_err(OfficeError::storage)?;
+                Ok(((), None))
+            })
+            .unwrap();
+    }
+}
+
+struct WModel {
+    rows: Vec<u64>,
+    events: Vec<(WorkActivityPosition, WorkEvent)>,
+    project: HashMap<String, Option<String>>,
+}
+
+fn qa_model(fx: &Fx) -> WModel {
+    fx.store
+        .read(|db| {
+            let rows = db
+                .prepare("SELECT seq FROM work_feed ORDER BY seq DESC")
+                .unwrap()
+                .query_map([], |r| Ok(r.get::<_, i64>(0)? as u64))
+                .unwrap()
+                .collect::<rusqlite::Result<Vec<_>>>()
+                .unwrap();
+            let mut events = db
+                .prepare("SELECT feed_seq, target_id, version, data FROM work_events")
+                .unwrap()
+                .query_map([], |r| {
+                    let data: String = r.get(3)?;
+                    Ok((
+                        WorkActivityPosition {
+                            feed_seq: r.get::<_, i64>(0)? as u64,
+                            target_id: r.get(1)?,
+                            version: r.get::<_, i64>(2)? as u64,
+                        },
+                        serde_json::from_str::<WorkEvent>(&data).unwrap(),
+                    ))
+                })
+                .unwrap()
+                .collect::<rusqlite::Result<Vec<_>>>()
+                .unwrap();
+            events.sort_by(|a, b| b.0.cmp(&a.0));
+            let project = db
+                .prepare("SELECT id, json_extract(data, '$.project_id') FROM work_items")
+                .unwrap()
+                .query_map([], |r| Ok((r.get::<_, String>(0)?, r.get::<_, Option<String>>(1)?)))
+                .unwrap()
+                .collect::<rusqlite::Result<HashMap<_, _>>>()
+                .unwrap();
+            Ok(WModel { rows, events, project })
+        })
+        .unwrap()
+}
+
+fn marker(seq: u64) -> WorkActivityPosition {
+    pos(seq, "", 0)
+}
+
+fn qa_valid_before(m: &WModel, q: &WorkActivityQuery) -> bool {
+    let Some(b) = &q.before else { return true };
+    if b.feed_seq > q.ceiling {
+        return false;
+    }
+    if b.target_id.is_empty() {
+        b.version == 0 && m.rows.contains(&b.feed_seq)
+    } else {
+        m.events.iter().any(|(p, _)| p == b)
+    }
+}
+
+type WPage = (Vec<(WorkActivityPosition, Option<u64>, u64)>, Option<WorkActivityPosition>, u64, bool);
+
+fn qa_flat(p: &WorkActivityPage) -> WPage {
+    (
+        p.entries.iter().map(|e| (e.position.clone(), e.at_ms, e.key)).collect(),
+        p.scanned_to.clone(),
+        p.frontier,
+        p.exhausted,
+    )
+}
+
+fn qa_oracle(m: &WModel, q: &WorkActivityQuery) -> WPage {
+    let (scan, limit) = (q.scan.max(1) as usize, q.limit.max(1) as usize);
+    let b = q.before.as_ref();
+    let start = b.map_or(q.ceiling, |b| b.feed_seq);
+    let mut entries: Vec<(WorkActivityPosition, Option<u64>, u64)> = Vec::new();
+    let (mut key, mut scanned_to, mut scanned) = (q.prev_key, None, 0usize);
+    for &seq in m.rows.iter().filter(|s| **s <= start) {
+        let partial = b.filter(|b| b.feed_seq == seq);
+        if partial.is_none() {
+            if scanned == scan {
+                return (entries, scanned_to, key, false);
+            }
+            scanned += 1;
+        }
+        scanned_to = Some(marker(seq));
+        for (p, event) in m.events.iter().filter(|(p, _)| p.feed_seq == seq) {
+            if b.is_some_and(|b| p >= b) {
+                continue;
+            }
+            let at_ms = org_work::parse_ms(&event.at);
+            key = at_ms.map_or(key, |a| a.min(key));
+            let in_project = q.project.as_deref().is_none_or(|want| {
+                m.project.get(&p.target_id).and_then(|x| x.as_deref()) == Some(want)
+            });
+            if q.involves(event) && in_project {
+                if entries.len() == limit {
+                    let last = entries.last().unwrap();
+                    return (entries.clone(), Some(last.0.clone()), last.2, false);
+                }
+                entries.push((p.clone(), at_ms, key));
+            }
+            scanned_to = Some(p.clone());
+        }
+    }
+    (entries, scanned_to, key, true)
+}
+
+fn qa_filters(rng: &mut Rng, q: &mut WorkActivityQuery) {
+    if rng.chance(30) {
+        q.member = Some(rng.pick(&["m0", "m1", "m3", "nobody"]).into());
+    }
+    if rng.chance(30) {
+        q.team_members = Some(match rng.below(3) {
+            0 => vec![],
+            1 => vec!["m2".into()],
+            _ => vec!["m0".into(), "m1".into()],
+        });
+    }
+    if rng.chance(30) {
+        q.project = Some(rng.pick(&["p0", "p1", "p2", "pX"]).into());
+    }
+}
+
+const QA_LS: [u32; 7] = [0, 1, 2, 3, 7, 100, 2000];
+
+fn qa_walk(fx: &Fx, m: &WModel, start: WorkActivityQuery) -> (Vec<(WorkActivityPosition, u64)>, usize) {
+    let (mut q, mut out, mut pages) = (start, Vec::<(WorkActivityPosition, u64)>::new(), 0usize);
+    loop {
+        pages += 1;
+        assert!(pages <= 200_000, "no progress");
+        let page = fx.reads.activity_page(&q).unwrap();
+        assert_eq!(page, fx.reads.activity_page(&q).unwrap(), "pure function of the query");
+        assert!(page.entries.len() <= q.limit.max(1) as usize);
+        assert_eq!(qa_flat(&page), qa_oracle(m, &q), "oracle mismatch for {q:?}");
+        if let Some(to) = &page.scanned_to {
+            let start = q.before.as_ref().map_or(q.ceiling, |b| b.feed_seq);
+            let counted = m
+                .rows
+                .iter()
+                .filter(|s| **s >= to.feed_seq && **s <= start)
+                .filter(|s| q.before.as_ref().is_none_or(|b| b.feed_seq != **s))
+                .count();
+            assert!(counted <= q.scan.max(1) as usize, "scan cap: {counted} > {}", q.scan);
+        }
+        assert!(page.frontier <= q.prev_key);
+        for w in page.entries.windows(2) {
+            assert!(w[0].position > w[1].position && w[0].key >= w[1].key);
+        }
+        if let (Some(last), Some(first)) = (out.last(), page.entries.first()) {
+            assert!(last.0 > first.position, "duplicate/disorder at the join");
+            assert!(last.1 >= first.key);
+        }
+        out.extend(page.entries.iter().map(|e| (e.position.clone(), e.key)));
+        if page.exhausted {
+            return (out, pages);
+        }
+        let to = page.scanned_to.clone().expect("a non-exhausted page scanned something");
+        assert!(q.before.as_ref().is_none_or(|b| to < *b), "no progress {to:?} vs {:?}", q.before);
+        (q.before, q.prev_key) = (Some(to), page.frontier);
+    }
+}
+
+#[test]
+fn qa_work_random_walks_join_to_the_unpaged_read_and_match_the_oracle() {
+    let (mut walks, mut single, mut latest_checks, mut invalid) = (0, 0, 0, 0);
+    let sizes = [0usize, 1, 2, 5, 40, 300, 1500];
+    for seed in 1..=40u64 {
+        let size = sizes[(seed % 7) as usize];
+        let mut rng = Rng(seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1);
+        let fx = setup(true);
+        qa_fill(&fx, &mut rng, size);
+        let m = qa_model(&fx);
+        let head = fx.reads.head().unwrap().1;
+        assert_eq!(head, m.rows.first().copied().unwrap_or(0));
+        // Unpaged read: independent key model.
+        let mut base = query(head);
+        (base.limit, base.scan) = (u32::MAX, u32::MAX);
+        let whole = fx.reads.activity_page(&base).unwrap();
+        assert!(whole.exhausted);
+        let mut key = u64::MAX;
+        let expect: Vec<_> = m
+            .events
+            .iter()
+            .map(|(p, e)| {
+                key = org_work::parse_ms(&e.at).map_or(key, |a| a.min(key));
+                (p.clone(), key)
+            })
+            .collect();
+        assert_eq!(
+            whole.entries.iter().map(|e| (e.position.clone(), e.key)).collect::<Vec<_>>(),
+            expect
+        );
+        let big = size > 300;
+        for _ in 0..4 {
+            let mut q = query(if rng.chance(30) && head > 1 { 1 + rng.below(head) } else { head });
+            q.limit = rng.pick(&QA_LS);
+            q.scan = rng.pick(&QA_LS);
+            if big && (q.limit <= 3 || q.scan <= 1) && rng.chance(70) {
+                q.limit = 100;
+            }
+            qa_filters(&mut rng, &mut q);
+            if rng.chance(20) {
+                q.prev_key = rng.pick(&[0u64, T0 + 20_000, u64::MAX - 1]);
+            }
+            let mut whole_q = q.clone();
+            (whole_q.limit, whole_q.scan) = (u32::MAX, u32::MAX);
+            let whole_f = fx.reads.activity_page(&whole_q).unwrap();
+            assert!(whole_f.exhausted);
+            let (joined, pages) = qa_walk(&fx, &m, q.clone());
+            assert_eq!(
+                joined,
+                whole_f.entries.iter().map(|e| (e.position.clone(), e.key)).collect::<Vec<_>>(),
+                "join != unpaged: {q:?} ({pages} pages)"
+            );
+            walks += 1;
+        }
+        for _ in 0..25 {
+            let mut q = query(head);
+            if rng.chance(40) {
+                q.ceiling = rng.below(head + 1);
+            }
+            q.limit = rng.pick(&QA_LS);
+            q.scan = rng.pick(&QA_LS);
+            qa_filters(&mut rng, &mut q);
+            q.prev_key = rng.pick(&[u64::MAX, 0, T0 + 30_000, T0, 1]);
+            if rng.chance(75) {
+                q.before = Some(match rng.below(6) {
+                    0 | 1 if !m.events.is_empty() => m.events[rng.below(m.events.len() as u64) as usize].0.clone(),
+                    2 => marker(rng.below(head + 3)),
+                    3 => pos(rng.below(head + 3), rng.pick(&["A", "H", "Z", "nope"]), rng.below(6)),
+                    4 => pos(rng.below(head + 1), "", rng.below(2)),
+                    _ => marker(1 + rng.below(head.max(1))),
+                });
+            }
+            let got = fx.reads.activity_page(&q);
+            if qa_valid_before(&m, &q) {
+                let got = got.unwrap_or_else(|e| panic!("valid query refused ({e:?}): {q:?}"));
+                assert_eq!(qa_flat(&got), qa_oracle(&m, &q), "{q:?}");
+                single += 1;
+            } else {
+                assert!(matches!(got, Err(WorkActivityError::InvalidPosition)), "{q:?}: {got:?}");
+                invalid += 1;
+            }
+        }
+        // latest_by_project against the model
+        for _ in 0..4 {
+            let ceiling = rng.pick(&[0u64, head, head / 2, head + 5, u64::MAX, i64::MAX as u64, i64::MAX as u64 + 1]);
+            let projects: Vec<String> = ["p0", "p1", "p2", "pX", "p0"][..(1 + rng.below(5) as usize)]
+                .iter()
+                .map(|s| s.to_string())
+                .collect();
+            let got = fx.reads.latest_by_project(ceiling, &projects).unwrap();
+            let want: Vec<(String, LatestActivity)> = projects
+                .iter()
+                .map(|p| {
+                    let newest = m
+                        .events
+                        .iter()
+                        .filter(|(e, _)| e.feed_seq <= ceiling)
+                        .filter(|(e, _)| m.project.get(&e.target_id).and_then(|x| x.as_deref()) == Some(p.as_str()))
+                        .next();
+                    let v = match newest {
+                        None => LatestActivity::None,
+                        Some((_, e)) => org_work::parse_ms(&e.at).map_or(Unknown, At),
+                    };
+                    (p.clone(), v)
+                })
+                .collect();
+            assert_eq!(got, want, "latest_by_project ceiling {ceiling} projects {projects:?}");
+            latest_checks += 1;
+        }
+    }
+    eprintln!("QA work: {walks} walks, {single} valid single pages, {invalid} invalid befores, {latest_checks} latest_by_project");
+}
+
+fn wk_kind(r: &Result<WorkActivityPage, WorkActivityError>) -> String {
+    match r {
+        Ok(p) => format!(
+            "ok entries={} scanned_to={:?} frontier={} exhausted={}",
+            p.entries.len(),
+            p.scanned_to.as_ref().map(|t| (t.feed_seq, t.target_id.as_str(), t.version)),
+            p.frontier,
+            p.exhausted
+        ),
+        Err(WorkActivityError::SnapshotRequired) => "SnapshotRequired".into(),
+        Err(WorkActivityError::InvalidPosition) => "InvalidPosition".into(),
+        Err(WorkActivityError::Store(e)) => format!("Store({e:?})"),
+    }
+}
