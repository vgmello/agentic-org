+fn qa_kind(r: &Result<ActivityPage, ActivityError>) -> String {
+    match r {
+        Ok(p) => format!(
+            "ok entries={} scanned_to={:?} frontier={} exhausted={}",
+            p.entries.len(),
+            p.scanned_to.map(|t| (t.seq, t.index)),
+            p.frontier,
+            p.exhausted
+        ),
+        Err(ActivityError::SnapshotRequired) => "SnapshotRequired".into(),
+        Err(ActivityError::Store(e)) => format!("Store({e:?})"),
+    }
+}
