($ (# [$ doc : meta]) * $ name : ident) => { $ (# [$ doc]) * # [derive (Serialize , Deserialize)] # [serde (transparent)] pub struct $ name (SecretText) ; impl $ name { # [doc = " Wrap a non-empty secret."] pub fn new (text : String) -> Result < Self , &'static str > { SecretText :: new (text) . map ($ name) } # [doc = " The secret, for the one use it has. Never log or format it."] pub fn expose (& self) -> & str { self . 0 . expose () } } impl std :: fmt :: Debug for $ name { fn fmt (& self , f : & mut std :: fmt :: Formatter <'_ >) -> std :: fmt :: Result { f . write_str (concat ! (stringify ! ($ name) , "(<redacted>)")) } } } ;
