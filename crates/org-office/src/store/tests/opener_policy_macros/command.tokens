($ (# [$ doc : meta]) * $ call : ident , $ method : literal , $ params : ident { $ ($ (# [$ fattr : meta]) * $ field : ident : $ ty : ty) ,* $ (,) ? }) => { $ (# [$ doc]) * pub struct $ call ; # [doc = concat ! ("Params of `" , $ method , "`.")] # [derive (Debug , Clone , PartialEq , Eq , Serialize , Deserialize)] pub struct $ params { # [doc = " Client-made: an uppercase Crockford ULID, 26 characters (`invalid_request`"] # [doc = " otherwise). A retry with the same id and params gets the stored answer, refusals"] # [doc = " included; the same id with different params is `invalid_request`. See the module"] # [doc = " docs, \"Command ids and retries\"."] pub command_id : String , $ ($ (# [$ fattr]) * pub $ field : $ ty ,) * } impl Call for $ call { const METHOD : &'static str = $ method ; type Params = $ params ; type Result = CommandAccepted ; } } ;
