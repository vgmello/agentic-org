($ (# [$ doc : meta]) * $ call : ident , $ method : literal , $ params : ident { $ ($ (# [$ fattr : meta]) * $ field : ident : $ ty : ty) ,* $ (,) ? }) => { $ (# [$ doc]) * pub struct $ call ; # [doc = concat ! ("Params of `" , $ method , "`.")] # [derive (Debug , Clone , PartialEq , Eq , Serialize , Deserialize)] pub struct $ params { # [doc = " Client-made: an uppercase Crockford ULID, 26 characters. A retry with the same id"] # [doc = " and params gets the same answer; the same id with other params is"] # [doc = " `invalid_request`."] pub change_id : String , $ ($ (# [$ fattr]) * pub $ field : $ ty ,) * } impl Call for $ call { const METHOD : &'static str = $ method ; type Params = $ params ; type Result = WorkAccepted ; } } ;
