($ ($ variant : ident , $ params : ident , $ call : ident , $ native : ident , $ name : literal { $ ($ (# [$ attr : meta]) * $ field : ident : $ ty : ty ,) * } ;) *) => { # [doc = " Closed operations selected by a trusted route, never by a browser body."] # [derive (Debug , Clone , Copy , PartialEq , Eq , Serialize , Deserialize)] pub enum OrgOperation { $ (# [serde (rename = $ name)] $ variant ,) * } $ (# [doc = " Strict browser params, without a second command identity."] # [derive (Clone , PartialEq , Eq , Serialize , Deserialize)] # [serde (deny_unknown_fields)] pub struct $ params { $ ($ (# [$ attr]) * pub $ field : $ ty ,) * }) * enum NativeCommand { $ ($ variant (org ::$ native) ,) * } impl OrgOperation { pub const ALL : &'static [Self] = & [$ (Self ::$ variant ,) *] ; pub fn name (self) -> &'static str { match self { $ (Self ::$ variant => $ name ,) * } } # [doc = " Explicit typed mapping. No string rewriting or generic RPC tunnel."] pub fn native_method (self) -> &'static str { match self { $ (Self ::$ variant => < org ::$ call as Call >:: METHOD ,) * } } # [doc = " Decode after the composition has selected/authenticated the route."] # [doc = " All failures are sanitized and happen before native dispatch."] pub fn decode (self , bytes : & [u8] , route_scope : & Scope) -> Result < OrgMutation , GatewayError > { let value : Value = serde_json :: from_slice (bytes) . map_err (| _ | invalid ()) ?; if ! value . is_object () { return Err (invalid ()) ; } let raw : RawMutation = serde_json :: from_value (value) . map_err (| _ | invalid ()) ?; let scope = raw . scope . into_scope () ; if & scope != route_scope || ! raw . params . is_object () { return Err (invalid ()) ; } let operation_id = raw . operation_id ; let native = match self { $ (Self ::$ variant => { let params : $ params = serde_json :: from_value (raw . params) . map_err (| _ | invalid ()) ?; NativeCommand ::$ variant (org ::$ native { command_id : operation_id . as_str () . to_owned () , $ ($ field : params .$ field . into () ,) * }) } ,) * } ; Ok (OrgMutation { operation : self , operation_id , scope , native }) } } impl OrgMutation { # [doc = " The numeric RPC ID is transport correlation; command_id remains operation_id."] pub fn native_request (& self , rpc_id : u64) -> Result < Request , serde_json :: Error > { match & self . native { $ (NativeCommand ::$ variant (params) => Request :: new ::< org ::$ call > (rpc_id , params) ,) * } } } }
