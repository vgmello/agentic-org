($ (# [$ doc : meta]) * $ name : ident { $ ($ (# [$ vdoc : meta]) * $ variant : ident = $ wire : literal) ,* $ (,) ? }) => { $ (# [$ doc]) * # [doc = ""] # [doc = " A value this build doesn't know, in any shape, decodes as `Unknown`; writers never"] # [doc = " send `Unknown` (`invalid_request`)."] # [derive (Debug , Clone , Copy , Default , PartialEq , Eq , Hash , Serialize)] # [non_exhaustive] pub enum $ name { $ ($ (# [$ vdoc]) * # [serde (rename = $ wire)] $ variant ,) * # [doc = " Missing or not known to this build."] # [default] # [serde (rename = "unknown")] Unknown , } impl <'de > Deserialize <'de > for $ name { fn deserialize < D : serde :: Deserializer <'de >> (d : D) -> Result < Self , D :: Error > { let value = serde_json :: Value :: deserialize (d) ?; Ok (match value . as_str () { $ (Some ($ wire) => $ name ::$ variant ,) * _ => $ name :: Unknown , }) } } } ;
