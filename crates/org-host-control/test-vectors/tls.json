          "uncovered": [
            "https://mac.local:8443"
          ]
        }
      },
      "expect": "unavailable"
    },
    {
      "name": "https without a key",
      "wire": {
        "ok": {
          "mode": "https",
          "cert": "-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----\n",
          "origin": "https://mac.local:8443",
          "hsts": "on"
        }
      },
      "expect": "refused"
    },
    {
