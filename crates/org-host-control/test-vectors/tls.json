  "bootstrap": [
    {
      "name": "success is completed with a session",
      "wire": {
        "status": "completed",
        "result": {
          "session": "bootstrap-session-handle"
        }
      },
      "expect": "completed"
    },
    {
      "name": "tls_required: a first https bootstrap without tls",
      "wire": {
        "status": "rejected",
        "refusal": {
          "code": "tls_required"
        }
      },
      "expect": "tls_required"
    },
    {
      "name": "tls_mismatch: a replay with another pair",
      "wire": {
        "status": "rejected",
        "refusal": {
          "code": "tls_mismatch"
        }
      },
      "expect": "tls_mismatch"
    },
    {
      "name": "already_bootstrapped: a different operation_id on a non-empty registry, even after bootstrap has finished, or a registry setup has no record of",
      "wire": {
        "status": "rejected",
        "refusal": {
          "code": "already_bootstrapped"
        }
      },
      "expect": "already_bootstrapped"
    },
    {
      "name": "bootstrap_finished: the recorded operation_id after bootstrap has finished, so setup goes on to step 5",
      "wire": {
        "status": "rejected",
        "refusal": {
