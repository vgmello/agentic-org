{
  "schema_version": 1,
  "comment": "X-02 \u00a73 version negotiation: every cell of the \u00a73 table, per connection and phase, and the client's instance_id check. hello without api means {1,1}. A server answers the highest version in both its range and the offered one, or unsupported_version and closes; a repeated hello answers the negotiated version if the offered range includes it, and otherwise unsupported_version and close. A first request that isn't hello proceeds as v1 only where v1_without_hello is true. v2 results always carry instance_id; a client refuses a v2 result whose instance_id is absent or isn't the selected instance's, and any api_version outside the range it offered. \"api\": null is an absent api, a v1 hello. A malformed api (anything but null or an object with exactly the keys min and max, 1 <= min <= max <= 2^32-1) fails hello's decode: the server answers invalid_request, without negotiating or closing.",
  "instance_id": "01M72N8MG00000000000000I01",
  "connections": {
    "office_socket_move2": {
      "comment": "An office socket from move 2a: SUPPORTED_API = {1,2}. A first request that isn't hello is allowed and treated as v1.",
      "accepts": {
        "min": 1,
        "max": 2
      },
      "v1_without_hello": true
    },
    "office_socket_move3": {
      "comment": "An office socket from move 3: SUPPORTED_API = {2,2}.",
      "accepts": {
        "min": 2,
        "max": 2
      },
      "v1_without_hello": false
    },
    "host_made_channel": {
      "comment": "A host-made channel (gateway or local), from move 2a: no v1 client exists there, so api must include 2.",
      "accepts": {
        "min": 2,
        "max": 2
      },
      "v1_without_hello": false
    }
  },
