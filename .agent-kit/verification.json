{
  "version": 1,
  "timeout_seconds": 300,
  "base": "origin/v1",
  "projects": [
    {
      "path": ".",
      "checks": [
        {
          "argv": [
            "cargo",
            "fmt",
            "--check"
          ],
          "paths": [
            "*.rs",
            "Cargo.toml",
            "*/Cargo.toml",
            "*rustfmt.toml",
            "rust-toolchain.toml"
          ]
        },
        {
          "argv": [
            "python3",
            ".agent-kit/runtime/kit_rust_hygiene.py"
          ],
          "paths": [
            "Cargo.toml",
            "*/Cargo.toml",
            ".agent-kit/runtime/kit_rust_hygiene.py"
          ]
        },
        {
          "argv": [
            "cargo",
            "test",
            "--locked",
            "-p",
            "org-platform",
            "--test",
            "rust_hygiene",
            "--quiet"
          ],
          "paths": [
            "*.rs",
            "Cargo.toml",
            "*/Cargo.toml",
            "Cargo.lock",
            "rust-toolchain.toml"
          ]
        },
        {
          "argv": [
            "python3",
            "docs/design/organization-data/test_schema.py"
          ],
          "paths": [
            "docs/*",
            "crates/org-agent-runtime/src/*"
          ]
        },
        [
          "python3",
          ".agent-kit/runtime/kit_skills.py",
          "validate"
        ],
        {
          "argv": [
            "python3",
            "-m",
            "compileall",
            "-q",
            ".agent-kit/runtime"
          ],
          "paths": [
            ".agent-kit/runtime/*"
          ]
        },
        {
          "argv": [
            "python3",
            ".agent-kit/runtime/kit_hindsight_embed.py",
            "test"
          ],
          "paths": [
            ".agent-kit/runtime/*",
            ".agent-kit/tests/*",
            ".agent-kit/policy/*",
            ".agents/skills/*"
          ]
        }
      ]
    },
    {
      "path": "apps/agentic-org-ui",
      "checks": [
        {
          "argv": [
            "bun",
            "run",
            "check"
          ],
          "paths": [
            "apps/agentic-org-ui/*",
            "config/csp/*",
            "crates/*/test-vectors/*"
          ]
        },
        {
          "argv": [
            "node_modules/.bin/vitest",
            "run",
            "--testTimeout=30000"
          ],
          "paths": [
            "apps/agentic-org-ui/*",
            "config/csp/*",
            "crates/*/test-vectors/*"
          ]
        },
        {
          "argv": [
            "bun",
            "run",
            "build"
          ],
          "paths": [
            "apps/agentic-org-ui/*",
            "config/csp/*"
          ]
        }
      ]
    }
  ]
}
