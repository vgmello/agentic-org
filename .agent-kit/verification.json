{
  "version": 1,
  "timeout_seconds": 300,
  "projects": [
    {
      "path": ".",
      "checks": [
        [
          "cargo",
          "fmt",
          "--check"
        ],
        [
          "python3",
          "docs/design/organization-data/test_schema.py"
        ],
        [
          "python3",
          ".agent-kit/runtime/kit_skills.py",
          "validate"
        ],
        [
          "python3",
          "-m",
          "compileall",
          "-q",
          ".agent-kit/runtime"
        ],
        [
          "python3",
          ".agent-kit/runtime/kit_hindsight_embed.py",
          "test"
        ]
      ]
    },
    {
      "path": "apps/agentic-org-ui",
      "checks": [
        [
          "bun",
          "run",
          "check"
        ],
        [
          "bun",
          "run",
          "test"
        ],
        [
          "bun",
          "run",
          "build"
        ]
      ]
    }
  ]
}
