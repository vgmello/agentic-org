{
  "permissions": {
    "allow": [
      "Skill(svelte-code-writer)",
      "Skill(svelte-core-bestpractices)",
      "Skill(shadcn-svelte)",
      "Skill(playwright-cli)"
    ],
    "deny": [
      "Bash(npx shadcn-svelte:*)",
      "Bash(npx shadcn-svelte@latest:*)",
      "Bash(pnpm dlx shadcn-svelte:*)",
      "Bash(pnpm dlx shadcn-svelte@latest:*)",
      "Bash(bunx --bun shadcn-svelte@latest:*)",
      "Bash(npx playwright:*)",
      "Bash(npm init playwright:*)",
      "Bash(npm init playwright@latest:*)",
      "Bash(npm install -g @playwright/cli@latest:*)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "agentic-org": {
      "source": {
        "source": "directory",
        "path": "./.agents/marketplace"
      }
    }
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "svelte-lsp@agentic-org": true
  },
  "enabledMcpjsonServers": [
    "svelte"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/check-tools.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/check-tools.sh --gate",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
