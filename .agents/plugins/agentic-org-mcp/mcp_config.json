{
  "mcpServers": {
    "rust_analyzer": {
      "command": "sh",
      "args": [
        "-c",
        "exec mcp-language-server --workspace \"$(git rev-parse --show-toplevel)\" --lsp rust-analyzer"
      ]
    },
    "typescript_lsp": {
      "command": "sh",
      "args": [
        "-c",
        "exec mcp-language-server --workspace \"$(git rev-parse --show-toplevel)/apps/agentic-org-ui\" --lsp typescript-language-server -- --stdio"
      ]
    },
    "svelte_lsp": {
      "command": "sh",
      "args": [
        "-c",
        "exec mcp-language-server --workspace \"$(git rev-parse --show-toplevel)/apps/agentic-org-ui\" --lsp svelteserver -- --stdio"
      ]
    },
    "svelte": {
      "command": "sh",
      "args": [
        "-c",
        "cd \"$(git rev-parse --show-toplevel)/apps/agentic-org-ui\" && exec node node_modules/@sveltejs/mcp/dist/index.mjs"
      ]
    },
    "starter_kit_context": {
      "command": "python3",
      "args": [
        "-c",
        "import pathlib,runpy,subprocess,sys; p=pathlib.Path(subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip()); sys.argv.extend(['--repo',str(p)]); sys.path.insert(0,str(p/'.agent-kit/runtime')); runpy.run_path(str(p/'.agent-kit/runtime/kit_context.py'),run_name='__main__')",
        "serve"
      ]
    }
  }
}
