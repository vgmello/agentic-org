#!/bin/sh
# Run claude with every inherited Claude Code session variable removed: all
# CLAUDE* names except CLAUDE_CONFIG_DIR, plus AI_AGENT. (This spike's shell
# runs inside another agent's session, so they are all set.)
for v in $(env | sed -n -e 's/^\(CLAUDE[A-Za-z0-9_]*\)=.*/\1/p' -e 's/^\(AI_AGENT\)=.*/\1/p'); do
  [ "$v" = CLAUDE_CONFIG_DIR ] || unset "$v"
done
exec claude "$@"
