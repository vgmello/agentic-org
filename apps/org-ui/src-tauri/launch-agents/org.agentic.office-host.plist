<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.agentic.office-host</string>
  <!-- Relative to the app bundle: SMAppService resolves it, so moving the app keeps working. -->
  <key>BundleProgram</key>
  <string>Contents/MacOS/org-office-host</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- Restart the host if it dies; its office servers exit with it and it restarts them. -->
  <key>KeepAlive</key>
  <true/>
  <!-- Don't restart faster than every 10 s in a crash loop. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- Logout: launchd sends SIGTERM; the host closes its children's pipes and has 10 s grace. -->
  <key>ExitTimeOut</key>
  <integer>20</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.ellosoft.agentic-org</string>
  </array>
</dict>
</plist>
