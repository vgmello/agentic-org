{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: dragging the overlay title bar (and double-click to zoom), listening for the menu bar's navigate events, and the office commands. Nothing else: no paths, menus, fs or shell.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-office-ensure-running",
    "allow-office-ping",
    "allow-organization-create",
    "allow-connections-list",
    "allow-organizations-list",
    "allow-organization-open",
    "allow-org-snapshot",
    "allow-org-command",
    "allow-work-snapshot",
    "allow-work-get",
    "allow-work-command",
    "allow-login-item-status",
    "allow-login-item-set",
    "allow-login-item-open-settings",
    "allow-open-external-url",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
