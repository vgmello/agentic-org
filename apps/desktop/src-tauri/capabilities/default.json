{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: dragging the overlay title bar (and double-click to zoom), listening for the menu bar's navigate events, the office commands, and opening an http or https link from a chat message in the browser (one checked command, no shell). Nothing else: no paths, menus or fs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-office-ensure-running",
    "allow-office-ping",
    "allow-office-restart",
    "allow-organizations-peek",
    "allow-organization-create",
    "allow-connections-list",
    "allow-organizations-list",
    "allow-organization-open",
    "allow-org-snapshot",
    "allow-org-command",
    "allow-org-live-retry",
    "allow-work-snapshot",
    "allow-work-get",
    "allow-work-command",
    "allow-login-item-status",
    "allow-login-item-set",
    "allow-login-item-open-settings",
    "allow-open-external-url",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
