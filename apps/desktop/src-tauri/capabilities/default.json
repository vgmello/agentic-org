{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: dragging the overlay title bar (and double-click to zoom) and the office commands. Nothing else: no events, paths, menus, fs or shell.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-office-ensure-running",
    "allow-organization-create",
    "allow-connections-list",
    "allow-organizations-list",
    "allow-organization-open"
  ]
}
