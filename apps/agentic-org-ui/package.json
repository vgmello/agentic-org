{
	"name": "agentic-org-ui",
	"private": true,
	"version": "0.1.0",
	"license": "SEE LICENSE IN ../../LICENSE",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:mock": "vite dev --mode e2e",
		"build": "vite build && bun run check:build-assets",
		"check:build-assets": "bun scripts/check-build-assets.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "bun run build && playwright test",
		"test:e2e:full": "bun run build && playwright test",
		"test:e2e:journeys": "bun run build && PW_WEBKIT=1 playwright test --grep @journey --project=chromium --project=production --project=webkit",
		"test:e2e:affected": "bun scripts/ui-gate.ts run",
		"test:e2e:select": "bun scripts/ui-gate.ts select --explain",
		"test:e2e:areas": "bun scripts/ui-gate.ts areas",
		"test:e2e:verify": "bun scripts/ui-gate.ts verify",
		"test:e2e:real-instance": "playwright test --config playwright.real-instance.config.ts",
		"test:e2e:csp": "playwright test --config playwright.csp.config.ts",
		"test:e2e:csp-gateway": "bun scripts/csp-gateway.ts",
		"lint": "eslint . --max-warnings=0",
		"format": "prettier --write .",
		"format:check": "bun scripts/check-format.ts",
		"audit": "bun audit",
		"mcp:svelte": "node node_modules/@sveltejs/mcp/dist/index.mjs",
		"audit:check": "bun audit --audit-level=moderate --ignore=GHSA-3r8g-jcqq-3p5j --ignore=GHSA-6cf5-gc4q-fm3x"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.70.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "3.0.11",
		"@sveltejs/kit": "2.70.4",
		"@sveltejs/mcp": "0.1.30",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "24.19.2",
		"bits-ui": "2.20.6",
		"cn": "0.5.2",
		"eslint": "10.15.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"mode-watcher": "1.1.0",
		"prettier": "3.10.1",
		"prettier-plugin-svelte": "4.1.1",
		"shadcn-svelte": "1.8.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"svelte-sonner": "1.2.3",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	},
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": "26.13.0",
		"bun": "1.4.4"
	},
	"overrides": {
		"minimatch@>=7.0.0 <11.0.1": "11.0.8"
	}
}
